# Local-only defaults. Change passwords before sharing this stack.
DATABASE_PASSWORD=relay_dev_only

# Optional: model-backed incident diagnosis and assessment triage. Keep this secret in .env only.
# Use a Gemini API key supported by the current Google AI Studio/API key requirements.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Connection setup and model verification timeout.
RELAY_AI_TIMEOUT_MS=8000
# Total budget for one AI generation call, retries included (2000-120000). Keep below the frontend proxy's 20 s read timeout.
RELAY_AI_GENERATE_BUDGET_MS=18000

# Optional: verifies the GitHub API account. Public repository scans do not require this token.
GITHUB_TOKEN=

# Consecutive failed checks before an incident opens / healthy checks before it closes (1-10).
RELAY_MONITORING_FAILURE_THRESHOLD=2
RELAY_MONITORING_RECOVERY_THRESHOLD=2
# Health-check interval (ms). 60000 by default; lower it (e.g. 15000) for faster detection in a local rehearsal.
RELAY_MONITORING_INTERVAL_MS=60000
# Per-check timeout (ms). Raise it for applications whose health endpoint is slow, or healthy checks are recorded as unreachable.
RELAY_MONITORING_TIMEOUT_MS=2500

# Exact host allowlist for routine application health monitoring. Add only authorized targets.
RELAY_MONITORING_ALLOWED_HOSTS=localhost,127.0.0.1,host.docker.internal,test-target

# Exact host allowlist for non-invasive URL assessment. Public external hosts must be added explicitly.
# Example: RELAY_ASSESSMENT_ALLOWED_HOSTS=localhost,127.0.0.1,test-target,app.your-company.com
RELAY_ASSESSMENT_ALLOWED_HOSTS=localhost,127.0.0.1,test-target
# Opt-in: allow Live URL investigations of ANY host that resolves only to public IP addresses.
# Private, loopback, link-local, CGNAT and unique-local targets stay blocked (checked again before every request);
# standard ports only; no redirects, credentials or query strings. Only investigate sites you are authorized to assess.
RELAY_ASSESSMENT_ALLOW_PUBLIC_HOSTS=false

# Docker recovery is limited to explicitly named containers. Do not add production containers.
RELAY_DOCKER_ALLOWED_CONTAINERS=relay-aegis-test-target

# Deterministic self-healing engine
# Extra containers RELAY may inspect (never mutate), and an explicit dependency graph (app=dep1|dep2;app2=dep).
RELAY_DOCKER_INSPECT_CONTAINERS=
RELAY_DOCKER_DEPENDENCIES=
# Recovery guard: attempts per incident and per-container cooldown (a circuit breaker also stops repeated failures).
RELAY_RECOVERY_MAX_ATTEMPTS=2
RELAY_RECOVERY_COOLDOWN_SECONDS=60
# How long post-recovery verification may take before it is reported as "timed out" (never as success).
RELAY_RECOVERY_VERIFICATION_TIMEOUT_MS=30000
# Patch validation (build, tests, security re-scan) in disposable Docker containers. Off by default.
RELAY_SANDBOX_ENABLED=false
# Sandbox container network. "none" isolates it completely; Maven/npm projects that must download
# dependencies need "bridge". Containers always run with all capabilities dropped and resource limits.
RELAY_SANDBOX_NETWORK=none

# Authentication
# HMAC-SHA256 signing secret for access tokens, at least 32 bytes. Generate one, for example:
#   openssl rand -base64 48
# Leave blank only for throwaway local runs (a random key is used and access tokens reset on restart).
RELAY_AUTH_JWT_SECRET=
# Access token lifetime (1m-1h) and refresh session lifetime (max 90d).
RELAY_AUTH_ACCESS_TOKEN_TTL=15m
RELAY_AUTH_REFRESH_TOKEN_TTL=7d
# Refresh cookie Secure flag: auto (when the request is HTTPS), true (behind a TLS proxy) or false.
RELAY_AUTH_COOKIE_SECURE=auto
# Comma-separated emails granted the ADMIN role when they register; everyone else is USER.
RELAY_AUTH_ADMIN_EMAILS=

# GitHub remediation (Apply & Create PR). Never commit a real token.
# Use a fine-grained personal access token restricted to the repositories below, with repository permissions:
#   Contents: Read and write, Pull requests: Read and write, Metadata: Read-only.
# RELAY AEGIS only creates relay-aegis/fix/* branches, commits the reviewed patch and opens a pull request.
# It never pushes to the default branch, never force-pushes and never merges.
RELAY_GITHUB_TOKEN=
# Comma-separated owner/name; only these repositories can receive remediation pull requests.
RELAY_GITHUB_REMEDIATION_REPOSITORIES=
# Comma-separated emails allowed to apply remediations in addition to ADMIN users.
RELAY_GITHUB_REMEDIATION_APPROVERS=
