# Caddy obtains and renews a Let's Encrypt certificate for RELAY_DOMAIN by itself (ports 80 and 443 must be open).
# The frontend container serves the dashboard and forwards /api to the backend.
{$RELAY_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	reverse_proxy frontend:80
}
